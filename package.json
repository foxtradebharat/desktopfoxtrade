{
  "name": "foxtrade-journal",
  "productName": "FoxTrade",
  "description": "FoxTrade Journal Desktop Application",
  "author": "FoxTrade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:foxy": "node scripts/foxyGoldenTest.js",
    "test:unit": "vitest run",
    "test": "node scripts/foxyGoldenTest.js",
    "postinstall": "node scripts/brandDev.js",
    "brand:dev": "node scripts/brandDev.js",
    "electron:dev": "node scripts/brandDev.js && concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:local": "npm run build && electron-builder --win --publish always",
    "generate:icons": "electron ./scripts/generate-ico.js"
  },
  "build": {
    "appId": "com.foxtrade.app",
    "productName": "FoxTrade",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "foxtradebharat",
        "repo": "desktopfoxtrade",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-db/**/*",
      "main.js",
      "updater.js",
      "preload.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FoxTrade",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "FoxTrade Protocol",
        "schemes": [
          "foxtrade"
        ]
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.344.0",
    "radix-ui": "^1.6.7",
    "react": "^18.2.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^5.1.6",
    "vitest": "^1.6.1",
    "wait-on": "^9.5.1",
    "xlsx": "^0.18.5"
  }
}
