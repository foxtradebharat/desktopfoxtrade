{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/yahoo-api/(.*)",
      "destination": "https://query1.finance.yahoo.com/$1"
    },
    {
      "source": "/yahoo-search/(.*)",
      "destination": "https://query2.finance.yahoo.com/v1/finance/search$1"
    },
    {
      "source": "/api/screener/(.*)",
      "destination": "https://www.screener.in/api/$1"
    },
    {
      "source": "/screener-api/(.*)",
      "destination": "https://www.screener.in/api/$1"
    },
    {
      "source": "/nse-api/(.*)",
      "destination": "https://archives.nseindia.com/$1"
    },
    {
      "source": "/nse-main/(.*)",
      "destination": "https://www.nseindia.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
